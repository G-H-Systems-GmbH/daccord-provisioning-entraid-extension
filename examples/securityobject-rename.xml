<?xml version="1.0" encoding="UTF-8"?>
<!--
    renameSecurityObject - renames a group.
    Test call:
        java -Dlog4j2.level=DEBUG -jar <runnable-jar> renamesecurityobject /opt/GuH/daccord-provisioning-gadget/res config.xml securityobject-rename.xml
-->
<provisioning>

    <system>
        <systemid>YOUR_SYSTEM_ID</systemid>
    </system>

    <config>
        <!-- Collector of the Entra ID JavaConnector extension -->
        <collectorid>YOUR_COLLECTOR_ID</collectorid>
    </config>

    <task>
        <object_uniqueid>YOUR_GROUP_OBJECT_ID</object_uniqueid>
        <request_name>Example group (renamed)</request_name>
    </task>

</provisioning>
