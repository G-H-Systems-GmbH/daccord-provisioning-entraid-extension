<?xml version="1.0" encoding="UTF-8"?>
<!--
    moveAccount - Entra ID has no OUs; updates organisational fields.
    Test call:
        java -Dlog4j2.level=DEBUG -jar <runnable-jar> moveaccount /opt/GuH/daccord-provisioning-gadget/res config.xml account-move.xml
-->
<provisioning>

    <system>
        <systemid>YOUR_SYSTEM_ID</systemid>
    </system>

    <config>
        <!-- Collector of the Entra ID JavaConnector extension -->
        <collectorid>YOUR_COLLECTOR_ID</collectorid>
        <!-- Optional: accounts synced from AD -->
        <!-- <syncedaccount_policy>skipattributes</syncedaccount_policy>   skipattributes | fail | ignore -->
        <!-- <syncedaccount_cloudattributes>usageLocation,preferredLanguage</syncedaccount_cloudattributes> -->
    </config>

    <task>
        <object_uniqueid>YOUR_USER_OBJECT_ID</object_uniqueid>
        <request_department>Sales</request_department>
        <request_officelocation>Berlin</request_officelocation>
    </task>

</provisioning>
