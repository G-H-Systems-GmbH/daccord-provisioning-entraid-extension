<?xml version="1.0" encoding="UTF-8"?>
<!--
    modifyAccountPassword - sets a new password.
    Test call:
        java -Dlog4j2.level=DEBUG -jar <runnable-jar> modifyaccountpassword /opt/GuH/daccord-provisioning-gadget/res config.xml account-password.xml
-->
<provisioning>

    <system>
        <systemid>YOUR_SYSTEM_ID</systemid>
    </system>

    <config>
        <!-- Collector of the Entra ID JavaConnector extension -->
        <collectorid>YOUR_COLLECTOR_ID</collectorid>
        <!-- <password_forcechangenextsignin>true</password_forcechangenextsignin> -->
    </config>

    <task>
        <object_uniqueid>YOUR_USER_OBJECT_ID</object_uniqueid>
        <object_password>YOUR_NEW_PASSWORD</object_password>
    </task>

</provisioning>
